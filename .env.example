APP_NAME=Sudcali
APP_ENV=local
APP_KEY=
# Depuración apagada por defecto; enciéndela solo en tu equipo.
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# WebSocket de /empleados (server-socket.js). Sin URL ni secreto la página funciona sin tiempo real.
# WEBSOCKET_SECRET: genera uno con `php -r "echo bin2hex(random_bytes(32));"`
WEBSOCKET_URL=ws://localhost:3000
WEBSOCKET_SECRET=
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Servicio OSRM para trazar el camino al domicilio. Vacío: se dibuja una línea recta.
RUTAS_URL=https://router.project-osrm.org

# Producción (Práctica 6 / OWASP A02 y A04):
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://tu-dominio
# SESSION_SECURE_COOKIE=true
# SESSION_ENCRYPT=true
# LOG_LEVEL=warning
# IP privada del balanceador (por defecto 127.0.0.1,::1):
# TRUSTED_PROXIES=10.0.0.5
# Empieza bajo y súbelo a 31536000 cuando todo funcione con HTTPS:
# HSTS_MAX_AGE=300

# Contraseña de las cuentas de demostración (db:seed). Vacía: se genera una al azar.
DEMO_PASSWORD=

# Docker (compose.yml, Práctica 5). Contraseña de la base dentro de los contenedores: ponle un valor largo.
DOCKER_DB_PASSWORD=
